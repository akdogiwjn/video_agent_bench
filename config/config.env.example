# Video Agent Bench — environment configuration
# Copy to config.env and fill in your keys.

# --- Agent ---
# The model OpenClaw will use for task execution.
AGENT_MODEL=anthropic/claude-sonnet-4-6

# --- OpenClaw ---
# Path to the OpenClaw binary.
OPENCLAW_BIN=openclaw

# --- VideoWeaver GEN (foundation skill API keys) ---
# Used by VideoWeaver foundation skills (image-gen, video-gen, etc.)
ARK_API_KEY=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# ASR/TTS (optional, only if using ASR/TTS skills)
ASR_APPID=
ASR_TOKEN=

# --- VLM for GEN semantic verifier ---
# Used by verifier/gen/evaluate.py and tools/media/vlm_understand.py
# If ARK_API_KEY is set, uses Volcengine Doubao VLM by default.
# If only OPENAI_API_KEY is set, uses OpenAI GPT-4o-mini by default.
# Override with VLM_MODEL to use a specific model.
OPENAI_API_KEY=
# VLM_MODEL=
# ARK_BASE_URL=
# OPENAI_BASE_URL=

# --- AgenticVBench EDIT verifier keys ---
# The repurpose verifier uses Gemini + Anthropic as LLM judges.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Docker ---
# Image tag for the unified runtime.
DOCKER_IMAGE=video-agent-bench:1.0

# --- Runner ---
TIMEOUT=3600
