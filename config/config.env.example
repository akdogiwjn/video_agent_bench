# Video Agent Bench — environment configuration
# Copy to config.env and fill in your keys.

# --- Agent: DeepSeek ---
AGENT_MODEL=openai/deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- DashScope common ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# --- VLM ---
VLM_PROVIDER=dashscope
VLM_MODEL=qwen-vl-max
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Omni: video/audio understanding ---
OMNI_PROVIDER=dashscope
OMNI_MODEL=

# --- Image generation ---
IMAGE_GEN_PROVIDER=dashscope
IMAGE_GEN_MODEL=

# --- Video generation ---
VIDEO_GEN_PROVIDER=dashscope
VIDEO_GEN_MODEL=

# --- EDIT verifier ---
EDIT_VERIFIER_MODE=adapted

# Optional: official AgenticVBench verifier only
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Docker ---
DOCKER_IMAGE=video-agent-bench:1.0

# --- Runner ---
TIMEOUT=3600
